# Maintainer: Aran <local>
# 二进制包：从预构建的 portable tarball 安装，不重新编译 Flutter。
# 构建前把 dist/aran-<ver>-linux-x64.tar.gz 复制成 aran-<pkgver>.tar.gz 放到本目录，
# 或直接运行 scripts/package-linux.sh 自动完成。
pkgname=aran-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Transparent proxy scheduler for mihomo (explains every routing decision)"
arch=('x86_64' 'aarch64')
url="https://github.com/local/aran"
license=('GPL-3.0-only')
depends=('gtk3' 'libayatana-appindicator' 'zlib' 'glibc')
optdepends=(
  'mihomo: proxy kernel (or download it from within Aran)'
  'smartdns: optional DNS sidecar'
)
provides=('aran')
conflicts=('aran')
options=('!strip')
source=("aran-${pkgver}.tar.gz" "50-aran-kernel.rules")
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/50-aran-kernel.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/50-aran-kernel.rules"
  local dir="$srcdir/aran-${pkgver}-linux-x64"

  install -d "$pkgdir/opt/aran"
  cp -a "$dir"/. "$pkgdir/opt/aran/"
  rm -f "$pkgdir/opt/aran/README.txt" "$pkgdir/opt/aran/aran.desktop"

  install -d "$pkgdir/usr/bin"
  # Wrapper instead of a symlink to the launcher: no BASH_SOURCE guessing.
  cat > "$pkgdir/usr/bin/aran" <<'WRAP'
#!/bin/sh
exec /opt/aran/aran_app "$@"
WRAP
  chmod 755 "$pkgdir/usr/bin/aran"

  install -d "$pkgdir/usr/share/applications"
  install -Dm644 "$dir/aran.desktop" "$pkgdir/usr/share/applications/aran.desktop"
  sed -i 's|^Exec=aran|Exec=/usr/bin/aran|; s|^Icon=aran|Icon=aran|' \
    "$pkgdir/usr/share/applications/aran.desktop"

  install -Dm644 "$dir/share/icons/hicolor/512x512/apps/aran.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/aran.png"

  install -Dm644 "$dir/data/flutter_assets/assets/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/aran-app.png"

  # GPL-3.0 compliance for the bundled mihomo / smartdns binaries.
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  for f in "$dir"/share/licenses/aran/*; do
    [ -e "$f" ] && install -m644 "$f" "$pkgdir/usr/share/licenses/$pkgname/"
  done
}
